# Copy to .streamlit/secrets.toml (gitignored) and fill in your own keys,
# or paste this block into Streamlit Cloud → Settings → Secrets.
#
# Two or more keys are supported: free tiers rate-limit per key, so the app
# moves to the next one instead of dropping to its offline note.
[groq]
api_keys = [
  "gsk_your_first_key",
  "gsk_your_second_key",
]
